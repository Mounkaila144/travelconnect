APP_NAME=TravelConnect
APP_ENV=local
APP_KEY=base64:xxx
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travelconnect
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost

# Google OAuth (placeholder values)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx

# Apple Sign-In (placeholder values)
# APPLE_CLIENT_ID: Your Service ID (configured in Apple Developer Portal)
APPLE_CLIENT_ID=com.travelconnect.auth
# APPLE_CLIENT_SECRET: Auto-generated JWT from Apple credentials (leave empty, generated at runtime)
APPLE_CLIENT_SECRET=
# APPLE_REDIRECT_URI: Callback URL registered in Apple Developer Portal
APPLE_REDIRECT_URI=https://travelconnect.ptrniger.com/api/auth/apple/callback
# APPLE_TEAM_ID: Your Apple Developer Team ID
APPLE_TEAM_ID=xxx
# APPLE_KEY_ID: Key ID from Apple Developer portal
APPLE_KEY_ID=xxx
# APPLE_PRIVATE_KEY: Contents of your .p8 private key file (NEVER commit the actual key)
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Firebase (placeholder values)
FIREBASE_PROJECT_ID=travelconnect-xxx
FIREBASE_CREDENTIALS=/path/to/service-account.json

# OVH Object Storage (placeholder values)
OVH_ENDPOINT=https://s3.gra.cloud.ovh.net
OVH_ACCESS_KEY=xxx
OVH_SECRET_KEY=xxx
OVH_BUCKET=travelconnect-avatars
OVH_REGION=gra
OVH_URL=https://travelconnect-avatars.s3.gra.cloud.ovh.net

# Google Maps API
# Restrict keys: Android → package SHA-1, iOS → bundle ID, Backend → server IPs
GOOGLE_MAPS_API_KEY=xxx

# Admin Panel
ADMIN_EMAIL=admin@travelconnect.app
ADMIN_PASSWORD=change_me_strong_password

VITE_APP_NAME="${APP_NAME}"

# ============================================
# PRODUCTION SETTINGS (uncomment and configure)
# ============================================
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://api.travelconnect.app
# LOG_CHANNEL=daily
# LOG_LEVEL=warning
# SESSION_LIFETIME=480
# DB_DATABASE=travelconnect_prod
# DB_USERNAME=travelconnect
# DB_PASSWORD=strong_random_password
